struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
struct s
  param p
  host.eval "extra = 5"
  host.eval "q = p"
  host.eval "q.move 3"
  host.eval "p.y ="
  func get
    return (host.show p q extra)
  endfunc
endstruct
a = s (pt 1 2)
b = a
console.writeline (host.show a b (equal a b))
console.writeline (a.get)
console.writeline (b.get)
b.q.move 1
console.writeline (a.get)
console.writeline (b.get)
console.writeline b.p.y
