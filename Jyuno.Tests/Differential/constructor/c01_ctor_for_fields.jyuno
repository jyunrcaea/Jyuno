struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
struct s
  param l
  total = 0
  first = null
  for e l
    total = add total e.x
    if (equal first null)
      first = e
    end
    func helper
      return total
    endfunc
    total = add total (helper)
  end
endstruct
src = list (pt 1 1) (pt 2 2)
a = s src
b = a
b.first.move 5
console.writeline (host.show a b src)
console.writeline (equal a b)
c = s (list (pt 1 1) (pt 2 2))
console.writeline (equal a c)
