struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
struct s
  param a
  param b
  t = a
  a = b
  b = t
  t =
  a.move 1
endstruct
p = pt 1 1
q = pt 2 2
v = s p q
w = v
w.a.move 10
console.writeline (host.show v w p q)
console.writeline v.t
