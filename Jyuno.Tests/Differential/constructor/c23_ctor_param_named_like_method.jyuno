struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
struct s
  param move
  func get
    return move
  endfunc
endstruct
a = s (pt 1 2)
b = a
b.move.move 3
console.writeline (host.show a b (a.get) (b.get))
