struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
struct box
  param a
  param b
  items = list 1 2
  func grow
    param n
    a.x = add a.x n
    list.push items n
    return (length items)
  endfunc
  func swap
    t = a
    a = b
    b = t
  endfunc
  func geta
    return a
  endfunc
endstruct
struct top
  param k
  param extra
  func deep
    k.a.move 1
    return k.a.x
  endfunc
endstruct
tt = top (box (pt 1 2) (pt 3 4)) (pt 9 9)
u = tt
u.k.a.x = 50
u.k.swap
console.writeline (host.show tt u (tt.deep) (u.deep))
tt.k = u.k
tt.k.b.move 1
console.writeline (host.show tt u (equal tt u) (equal tt.k u.k))
u.k.a = tt.extra
u.k.a.move 2
console.writeline (host.show tt u)
v = top u.k u.k.a
u.k.a.y = 0
console.writeline (host.show v)
func mk
  return (top (box (pt 0 0) (pt 0 0)) (pt 0 0))
endfunc
x = mk
y = x
x.k.grow 3
console.writeline (host.show x y (mk))
