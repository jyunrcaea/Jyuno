struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
struct s
  param p
  param mode
  if (equal mode 1)
    func p.x
      return 42
    endfunc
  end
  if (equal mode 2)
    p.x:
  end
  if (equal mode 3)
    7 = p.x
  end
endstruct
a = s (pt 1 2) 1
b = a
console.writeline (a.p.x)
console.writeline (b.p.x)
c = s (pt 1 2) 2
d = c
console.writeline (host.show c.p.x d.p.x)
e = s (pt 1 2) 3
f = e
console.writeline (host.show e.p.x)
console.writeline (host.show f.p.x)
