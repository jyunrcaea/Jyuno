struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
log = list
g = 0
struct s
  param p
  g = p
  list.push log p
  p.move 1
  g.move 10
endstruct
a = s (pt 1 2)
b = a
b.p.move 100
console.writeline (host.show a b g log)
