struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
struct s
  p = pt 1 2
  p = pt 3 4
  p = 5
  p = pt 6 7
  q = p
  p = q.plus p
endstruct
a = s
b = a
b.p.move 1
console.writeline (host.show a b a.p.x b.p.x a.q.x)
