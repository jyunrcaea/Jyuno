struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
struct pair
  param p
  a = p
  b = p
  a.move 1
endstruct
struct wrap
  param p
  inner = pair p
  again = pair p
  inner.b.move 5
endstruct
w = wrap (pt 0 0)
v = w
v.inner.a.move 10
console.writeline (host.show w v)
