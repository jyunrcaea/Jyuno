struct pt
    param x
endstruct
func first
    param a
    return a.x
endfunc
p = pt 1
q = pt 2
console.writeline (first p q (pt 3))
func noargs
    return 5
endfunc
console.writeline (noargs p q)
func par
    param a
    return (a)
endfunc
r = par p
r.x = 10
console.writeline (string p)
console.writeline (string r)
console.writeline (par 3)
console.writeline (first)
