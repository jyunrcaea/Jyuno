struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
func f

  param p

  return p.x

endfunc
func g
  param p
  "comment"
  return p.x
endfunc
func h
  param p
  return p.x
  return p.y
endfunc
func k
  return 5
  param p
endfunc
console.writeline (host.show (f (pt 1 2)) (g (pt 1 2)) (h (pt 1 2)) (k (pt 1 2)))
