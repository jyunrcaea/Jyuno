struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
p = pt 100 200
func f
  param p
  return (list p.x p.y (p.sum))
endfunc
func g
  param q
  return (list p.x q.x (p.move 1) p)
endfunc
console.writeline (host.show (f (pt 1 2)) (f 5) (f) (g (pt 7 7)) p)
