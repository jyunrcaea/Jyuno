struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
func f
  param p
  return (list p.x (host.eval "local p = 5") p (host.eval "p = pt 7 7") p.x p (host.eval "p.x") (host.eval "local q = p") (host.eval "q.move 1") (host.eval "q") p)
endfunc
console.writeline (host.show (f (pt 1 2)))
return 0
