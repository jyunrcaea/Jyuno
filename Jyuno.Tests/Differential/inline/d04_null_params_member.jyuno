struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
p.x = "outer p.x"
func f
  param p
  return p.x
endfunc
func g
  param p
  param q
  return (list p q q.x)
endfunc
console.writeline (host.show (f) (f 5) (f (pt 1 2)) (f null))
console.writeline (host.show (g (pt 1 2)))
