struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
struct box
  param a
  param b
  items = list 1 2
  func grow
    param n
    a.x = add a.x n
    list.push items n
    return (length items)
  endfunc
  func swap
    t = a
    a = b
    b = t
  endfunc
  func geta
    return a
  endfunc
endstruct
func ga
  param q
  return q.a
endfunc
k = box (pt 1 2) (pt 3 4)
a = ga k
a.move 10
b = ga (box (pt 5 5) (pt 6 6))
b.move 1
c = ga (host.keep k)
c.move 2
console.writeline (host.show k a b c (host.get))
