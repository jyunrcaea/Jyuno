struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
p = "outer"
func f
  param p
  return (list p (host.eval "p =") p (host.eval "p =") )
endfunc
console.writeline (host.show (f (pt 1 2)) p)
console.writeline p
return 0
