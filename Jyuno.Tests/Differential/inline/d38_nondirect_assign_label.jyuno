struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
g = 0
func f
  param p
  return (g = p) (h = p) (lbl:)
endfunc
func f2
  param p
  return (list (x = p.x) x (p =) (host.eval "p"))
endfunc
func f3
  param p
  return (list (lbl:) lbl (5 = five) p)
endfunc
console.writeline (host.show (f (pt 1 2)) g)
console.writeline (host.show (f3 (pt 1 2)))
console.writeline (host.show (f2 (pt 1 2)))
return 0
