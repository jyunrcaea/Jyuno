struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
func f
  param p
  return (list p.x (host.opt "inline" 0) (g p) (host.opt "inline" 1) (g p) (host.eval "p.x = 5") (g p) p)
endfunc
func g
  param q
  return (list q.x (q.move 1))
endfunc
console.writeline (host.show (f (pt 1 2)))
return 0
