struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
func f
  param p
  return (host.keep p)
endfunc
func g
  param p
  return (list (host.keep p) (p.move 1) (host.get) p)
endfunc
a = pt 1 2
b = f a
b.move 10
c = host.get
c.move 100
console.writeline (host.show a b c (host.get))
console.writeline (host.show (g a) a (host.get))
