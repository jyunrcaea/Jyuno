struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
func f
  param p
  param q
  return (list p q (host.eval "q = 5") q (host.eval "p") (host.eval "local r = q") )
endfunc
console.writeline (host.show (f) (f 1) (f (pt 1 2)))
return 0
