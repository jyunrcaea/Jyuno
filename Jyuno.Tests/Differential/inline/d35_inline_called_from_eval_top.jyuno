struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
func f
  param p
  return (list p.x (host.cur))
endfunc
a = pt 1 2
console.writeline (host.show (host.eval "f a") (host.eval "(f (pt 5 5))") (host.eval "x = f a") (host.eval "x"))
return 0
