struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
func f
  param p
  return (p 0)
endfunc
func g
  param p
  return (p 0 5) p
endfunc
l = list 1 2
console.writeline (host.show (f l) (g l) l)
console.writeline (host.show (f (list (pt 1 2))))
console.writeline (f (pt 1 2))
