struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
a = pt 1 2
host.settrap "a ="
console.writeline (and a host.trap)
a = pt 1 2
console.writeline (or a host.trap)
a = pt 1 2
host.settrap "a = 0"
console.writeline (and a host.trap)
console.writeline (host.show a)
