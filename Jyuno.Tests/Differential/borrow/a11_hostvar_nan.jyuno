struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
host.var = pt (host.nan) 2
console.writeline (equal host.var host.var)
a = host.var
console.writeline (equal a a)
console.writeline (equal a host.var)
console.writeline (not host.var)
