struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
struct box
  param a
  param b
  items = list 1 2
  func grow
    param n
    a.x = add a.x n
    list.push items n
    return (length items)
  endfunc
  func swap
    t = a
    a = b
    b = t
  endfunc
  func geta
    return a
  endfunc
endstruct
k = box (pt 1 2) (pt 3 4)
func tr
  k.a.x = 9
  return (pt 1 2)
endfunc
host.settrap "tr"
console.writeline (equal k.a host.trap)
console.writeline (host.show k)
