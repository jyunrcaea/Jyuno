struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
g = pt 1 2
func tr
  g.x = 50
  return (pt 1 2)
endfunc
func cmp
  return (equal g host.trap)
endfunc
host.settrap "tr"
console.writeline (cmp)
console.writeline (host.show g)
