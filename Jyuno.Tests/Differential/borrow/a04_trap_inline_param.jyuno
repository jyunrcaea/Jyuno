struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
func cmp
  param p
  return (less p host.trap)
endfunc
host.settrap "p.x = 99"
console.writeline (cmp (pt 1 2))
