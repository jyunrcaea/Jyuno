struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
a = pt 1 2
func tr
  a.x = 99
  return (pt 1 2)
endfunc
host.settrap "tr"
console.writeline (equal a host.trap)
console.writeline (host.show a)
