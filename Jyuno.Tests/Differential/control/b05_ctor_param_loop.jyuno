struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
struct s
  i = 0
  while (less i 2)
    param p
    p.move 1
    i = add i 1
  end
  q = p
endstruct
a = pt 1 2
v = s a
console.writeline (host.show v a (s (pt 7 7)))
w = v
w.p.move 5
console.writeline (host.show v w)
