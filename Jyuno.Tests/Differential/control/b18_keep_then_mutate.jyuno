struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
func mk
  return (host.keep (pt 1 2))
endfunc
a = mk
a.move 5
b = host.get
b.move 7
console.writeline (host.show a b (host.get))
c = host.keep a
c.move 1
d = (host.keep (a.plus b))
d.move 3
console.writeline (host.show a c d (host.get 0) (host.get 1) (host.get 2))
