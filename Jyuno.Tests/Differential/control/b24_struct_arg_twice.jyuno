struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
func f
  param p
  param q
  p.move 1
  q.move 10
  return (list p q)
endfunc
a = pt 0 0
console.writeline (host.show (f a a) a)
l = list (pt 5 5)
console.writeline (host.show (f (l 0) (l 0)) l)
console.writeline (host.show (f (host.keep a) (host.get)) (host.get) a)
