struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
struct weird
  b.c = 1
  d = 2
endstruct
a.b = pt 10 20
a = weird
console.writeline (host.show a a.b a.d)
console.writeline a.b.c
console.writeline a.b.x
