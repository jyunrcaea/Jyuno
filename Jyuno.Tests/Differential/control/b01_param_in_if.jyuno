struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
func f
  param c
  if c
    param p
    p.move 1
  else
    param q
    q.move 2
    console.writeline (host.show q)
  end
  return p
endfunc
a = pt 1 2
console.writeline (host.show (f 1 a) (f 0 a a) a)
console.writeline (host.show (f 1 (pt 5 5) (pt 6 6)) (f 0 (pt 5 5) (pt 6 6)))
