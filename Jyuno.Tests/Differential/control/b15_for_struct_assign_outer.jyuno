struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
l = list (pt 1 1) (pt 2 2)
keep = pt 0 0
for e l
  e.move 10
  keep = e
  e.move 100
  l 0 e
end
console.writeline (host.show l keep)
for e l
  for f l
    e = f
    f.move 1
    console.writeline (host.show e f)
  end
end
console.writeline (host.show l)
