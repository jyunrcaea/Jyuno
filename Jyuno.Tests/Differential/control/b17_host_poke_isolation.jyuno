struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
struct bag
  param l
endstruct
b = bag (list 1 2)
console.writeline (host.poke b "l")
console.writeline (host.show b)
console.writeline (host.poke (bag (list 5)) "l")
host.keep b
console.writeline (host.poke (host.get) "l")
console.writeline (host.show b (host.get))
c = host.get
console.writeline (host.poke (host.get) "l")
console.writeline (host.show b c (host.get))
func f
  param p
  return (host.poke p "l")
endfunc
func g
  param p
  host.poke p "l"
  return p
endfunc
console.writeline (host.show (f b) b (g b) b)
