struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
a = pt 1 2
a.move =
b = a
console.writeline (b.move 1)
console.writeline (host.show a b)
console.writeline (a.move 1)
