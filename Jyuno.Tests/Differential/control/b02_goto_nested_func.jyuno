struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
func outer
  param p
  func inner
    param q
    n = 0
    again:
    q.move 1
    n = add n 1
    if (less n 3)
      goto again
    end
    return q
  endfunc
  r = inner p
  p.move 100
  return (list p r (inner p))
endfunc
a = pt 1 2
console.writeline (host.show (outer a) a (outer (pt 0 0)))
