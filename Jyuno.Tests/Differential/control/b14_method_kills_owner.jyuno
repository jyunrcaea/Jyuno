struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
struct s
  param x
  func kill
    g = 5
    x = add x 1
    return x
  endfunc
  func rebirth
    g = s 100
    x = add x 1
    return (list x g)
  endfunc
endstruct
g = s 1
console.writeline (g.kill)
console.writeline (host.show g)
g = s 2
console.writeline (host.show (g.rebirth) g)
h = s 3
g = h
console.writeline (host.show (g.rebirth) g h)
