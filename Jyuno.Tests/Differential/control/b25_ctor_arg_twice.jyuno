struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
struct box
  param a
  param b
  items = list 1 2
  func grow
    param n
    a.x = add a.x n
    list.push items n
    return (length items)
  endfunc
  func swap
    t = a
    a = b
    b = t
  endfunc
  func geta
    return a
  endfunc
endstruct
a = pt 0 0
k = box a a
k.a.move 1
console.writeline (host.show k a)
l = list (pt 5 5)
m = box (l 0) (l 0)
m.b.move 3
console.writeline (host.show m l)
n = box (host.keep a) (host.get)
n.a.move 9
console.writeline (host.show n (host.get) a)
