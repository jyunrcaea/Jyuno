struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
a = pt 1 2
l = list 1 2
x = 0
console.writeline (host.show x)
y = (x = (a 1))
console.writeline (host.show x y)
