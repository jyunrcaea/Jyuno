func idf
  param p
  return p
endfunc
func eqf
  param p
  param q
  return equal p q
endfunc
func ltf
  param p
  param q
  return less p q
endfunc
func gtf
  param p
  param q
  return p > q
endfunc
func nef
  param p
  param q
  return p != q
endfunc
func geta
  param p
  return p.a
endfunc
func pick
  param p
  param q
  return (equal p q) ? p : q
endfunc
