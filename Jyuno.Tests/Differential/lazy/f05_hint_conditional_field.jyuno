#!dump
shared = list 1
struct box
  param mode
  if (equal mode 0)
    items = 5
    other = 6
  end
  if (equal mode 1)
    items = shared
    other = 6
  end
  if (equal mode 2)
    items = 5
    other = shared
  end
  if (equal mode 3)
    other = shared
  end
endstruct
all = list
i = 0
while (less i 12)
  v = box (mod i 4)
  list.push shared (add 10 i)
  w = v
  list.push all (host.show v w)
  i = add i 1
end
for line all
  console.writeline line
end
a = box 1
b = box 3
c = box 0
list.push a.items 77
list.push b.other 88
console.writeline (host.show a b c shared)
return
