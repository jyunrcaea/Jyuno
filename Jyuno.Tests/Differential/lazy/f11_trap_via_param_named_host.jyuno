struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
endstruct
func f
  param q
  param host
  return (equal q host.trap)
endfunc
func g
  param q
  param host
  return (list (equal q host.trap) q.x)
endfunc
host.settrap "(pt (sub (q.move 8) 8) 4)"
v = pt 3 4
console.writeline (host.show (f v 1) (f (pt 3 4) 2) (g v 3) (g (pt 3 4) null) v)
return
