#!dump
struct pt
  param x
  param y
endstruct
struct bag
  param a
endstruct
struct seg
  param p
  param q
endstruct
shared = list 1
s1 = seg (pt 1 2) (bag shared)
list.push shared 2
s2 = seg (bag shared) (pt 3 4)
list.push shared 3
s3 = seg (pt 5 6) (pt 7 8)
s4 = seg (seg (pt 1 2) (bag shared)) (pt 9 9)
list.push shared 4
s5 = s4
list.push s5.p.q.a 500
list.push s1.q.a 100
console.writeline (host.show s1 s2 s3 s4 s5 shared)
struct holder
  param n
  inner = bag shared
  tag = pt n n
endstruct
h1 = holder 1
list.push shared 5
h2 = h1
list.push h2.inner.a 600
h3 = holder 2
list.push shared 6
console.writeline (host.show h1 h2 h3 shared)
return
