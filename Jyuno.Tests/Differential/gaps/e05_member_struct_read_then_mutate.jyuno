struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
struct box
  param a
  param b
  items = list 1 2
  func grow
    param n
    a.x = add a.x n
    list.push items n
    return (length items)
  endfunc
  func swap
    t = a
    a = b
    b = t
  endfunc
  func geta
    return a
  endfunc
endstruct
func f
  param q
  return (list q.a (q.a.move 3) q.a q (q.grow 2) q.items q)
endfunc
func g
  param q
  return (list q.items (list.push q.items 9) q.items (q.geta) (q.a.move 1) (q.geta))
endfunc
k = box (pt 1 2) (pt 3 4)
console.writeline (host.show (f k) k)
console.writeline (host.show (g k) k)
console.writeline (host.show (f (box (pt 1 2) (pt 3 4))) (g (box (pt 0 0) (pt 0 0))))
