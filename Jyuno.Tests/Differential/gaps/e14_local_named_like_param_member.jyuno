struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
func f
  param p
  local p.x = 9
  return p
endfunc
func g
  param p
  local p.z = 9
  return (list p p.z)
endfunc
console.writeline (host.show (f (pt 1 2)) (g (pt 1 2)))
