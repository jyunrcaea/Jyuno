struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
func f
  param p
  local q = (pt 5 5)
  q = p.plus q
  local r = q
  r.move 1
  return (list p q r q.x r.x)
endfunc
i = 0
repeat 3
  console.writeline (host.show (f (pt i i)))
  i = add i 1
end
