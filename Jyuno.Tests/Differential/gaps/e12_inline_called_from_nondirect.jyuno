struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
g = 0
func leaf
  param p
  return p.x
endfunc
func nd
  param p
  return (list (g = leaf p) g (leaf p) (p =) (host.eval "p"))
endfunc
p = "outer"
console.writeline (host.show (nd (pt 1 2)) g)
return 0
