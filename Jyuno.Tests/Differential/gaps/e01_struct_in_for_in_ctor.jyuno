leaked = list
struct outer
  param n
  for e (list 1)
    struct tap
      func get
        return n
      endfunc
    endstruct
    list.push leaked (tap)
  end
  func bump
    n = add n 1
    return n
  endfunc
endstruct
o = outer 10
o.n = 50
t = leaked 0
console.writeline (host.show (t.get) (o.bump) (t.get) o)
p = o
p.bump
console.writeline (host.show (t.get) p o)
