struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
g = 0
func inner
  param a
  return (g = a) a
endfunc
func mid
  param p
  return (list (inner p) g (inner p.x) g p)
endfunc
func top
  param p
  local g = "local g"
  return (list (mid p) g)
endfunc
console.writeline (host.show (top (pt 1 2)) g)
