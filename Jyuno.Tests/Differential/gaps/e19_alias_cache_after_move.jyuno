struct pt
  param x
  param y
  func move
    param d
    x = add x d
    return x
  endfunc
  func sum
    return (add x y)
  endfunc
  func plus
    param o
    return (pt (add x o.x) (add y o.y))
  endfunc
endstruct
struct box
  param a
  param b
  items = list 1 2
  func grow
    param n
    a.x = add a.x n
    list.push items n
    return (length items)
  endfunc
  func swap
    t = a
    a = b
    b = t
  endfunc
  func geta
    return a
  endfunc
endstruct
k = box (pt 1 2) (pt 3 4)
i = 0
while (less i 3)
  console.writeline (host.show k.a.x k.b.x (k.a.sum))
  k = box (pt (add i 10) 0) k.a
  console.writeline (host.show k.a.x k.b.x (k.a.sum))
  k.a = (pt 0 i)
  k.b = k.a
  i = add i 1
end
m = k
k.a.x = 99
console.writeline (host.show k m k.a.x m.a.x)
