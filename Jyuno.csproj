<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 테스트/벤치마크 프로젝트가 하위 폴더에 있으므로 라이브러리 빌드에서 제외 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Jyuno.Tests/**;Jyuno.Benchmarks/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- NuGet 패키지 정보 (버전은 릴리즈 워크플로우에서 태그로 지정) -->
  <PropertyGroup>
    <PackageId>Jyuno</PackageId>
    <Version>1.6.0</Version>
    <Authors>jyunrcaea</Authors>
    <Description>Interpreter for Jyuno, a small and lightweight language for easily adding safe plugin (scripting) support to C# programs.</Description>
    <PackageTags>jyuno;script;scripting;interpreter;plugin;language</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- NuGet에 보이는 README는 영어판(README.nuget.md). README.md를 고치면 같이 고쳐 주세요 -->
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/jyunrcaea/Jyuno</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jyunrcaea/Jyuno</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.nuget.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
